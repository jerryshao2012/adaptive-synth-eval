# =============================================================================
# Adaptive Synthetic Eval - Environment Variables
# =============================================================================

# Log Level: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
LOG_LEVEL=INFO

# =============================================================================
# RELIABILITY & RATE LIMITING
# =============================================================================

# Proactive Rate Shaping (TPM and RPM limits)
# Set these based on your provider's deployment quotas
# Tokens Per Minute:
# Represents the maximum number of tokens (input + output) you are allowed to send to the model provider within a
# rolling 60-second window.
MODEL_TPM=500000
# Requests Per Minute:
# Represents the maximum number of individual API calls you can make per minute.
MODEL_RPM=500

# Reactive Retries (Optional Exponential Backoff and Jitter)
# Maximum number of retry attempts when rate limit errors occur
MODEL_MAX_RETRIES=2
# Initial backoff time in seconds before first retry
MODEL_INITIAL_BACKOFF=0.5
# Maximum backoff time in seconds (cap for exponential backoff)
MODEL_MAX_BACKOFF=10.0
# Multiplier for exponential backoff (backoff = initial * multiplier^attempt)
MODEL_BACKOFF_MULTIPLIER=1.5
# Add jitter to prevent thundering herd problem (true/false)
MODEL_RETRY_JITTER=true

# =============================================================================
# UNIFIED CHATBOT CONFIGURATION
# =============================================================================

# RAG Configuration
# Endpoint URL for the Vanilla RAG API
RAG_ENDPOINT=https://your-vanilla-rag-endpoint.com/api/RAGResponse?code=YOUR_CODE
# Endpoint URL for the Graph RAG API
#RAG_ENDPOINT=https://your-graph-rag-endpoint.com/api/RAGResponse?code=YOUR_CODE
# Request timeout in seconds (default: 60.0)
RAG_TIMEOUT=3000
# RAG model to use (comma-separated list if multiple)
RAG_MODEL=Deployment-Model-gpt-4.1
# Temperature for RAG model (0.0 to 1.0, lower = more deterministic)
RAG_TEMPERATURE=0.01
# Whether to include source document references (true/false)
RAG_SOURCE_DOCUMENT_REFERENCE=true

# Authentication (optional)
# If your endpoints require bearer token authentication, set this variable
# The token will be automatically included in request headers
# CHATBOT_API_TOKEN=your_api_token_here

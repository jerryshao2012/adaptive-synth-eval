# =============================================================================
# Adaptive Synthetic Eval - Environment Variables
# =============================================================================

# Log Level: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
LOG_LEVEL=INFO

# =============================================================================
# RELIABILITY & RATE LIMITING
# =============================================================================

# Proactive Rate Shaping (TPM and RPM limits)
# Set these based on your provider's deployment quotas
# Tokens Per Minute:
# Represents the maximum number of tokens (input + output) you are allowed to send to the model provider within a
# rolling 60-second window.
MODEL_TPM=500000
# Requests Per Minute:
# Represents the maximum number of individual API calls you can make per minute.
MODEL_RPM=500

# Reactive Retries (Optional Exponential Backoff and Jitter)
# Maximum number of retry attempts when rate limit errors occur
MODEL_MAX_RETRIES=2
# Initial backoff time in seconds before first retry
MODEL_INITIAL_BACKOFF=0.5
# Maximum backoff time in seconds (cap for exponential backoff)
MODEL_MAX_BACKOFF=10.0
# Multiplier for exponential backoff (backoff = initial * multiplier^attempt)
MODEL_BACKOFF_MULTIPLIER=1.5
# Add jitter to prevent thundering herd problem (true/false)
MODEL_RETRY_JITTER=true

# =============================================================================
# UNIFIED CHATBOT CONFIGURATION
# =============================================================================

# Chatbot Configuration
# Endpoint URL for the Vanilla RAG API
CHATBOT_ENDPOINT=https://your-vanilla-rag-endpoint.com/api/RAGResponse?code=YOUR_CODE
# Endpoint URL for the Graph RAG API
# CHATBOT_ENDPOINT=https://your-graph-rag-endpoint.com/api/RAGResponse?code=YOUR_CODE
# Request timeout in seconds (default: 60.0)
CHATBOT_TIMEOUT=3000
# Chatbot model to use (comma-separated list if multiple)
CHATBOT_MODEL=Deployment-Model-gpt-4.1
# Temperature for Chatbot model (0.0 to 1.0, lower = more deterministic)
CHATBOT_TEMPERATURE=0.01
# Whether to include source document references (true/false)
CHATBOT_SOURCE_DOCUMENT_REFERENCE=true


# Authentication (optional)
# If your endpoints require bearer token authentication, set this variable
# The token will be automatically included in request headers
# CHATBOT_API_TOKEN=your_api_token_here

# =============================================================================
# USER SIMULATION LLM CONFIGURATION
# =============================================================================
# Configure an LLM provider to generate realistic user messages during simulation.
# The system auto-detects which provider to use based on available environment variables.
# Uncomment and configure ONE of the following sections:

# --- Option 1: Azure OpenAI ---
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
# AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
# AZURE_OPENAI_API_VERSION=2024-12-01-preview
# Optional: For Managed Identity authentication
# AZURE_AUTH_TYPE=managed_identity
# AZURE_CLIENT_ID=your_managed_identity_client_id
# AZURE_OPENAI_SCOPE=https://cognitiveservices.azure.com/.default

# --- Option 2: Anthropic Claude ---
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# MODEL_NAME=claude-sonnet-4-5-20250929

# --- Option 3: OpenAI ---
# OPENAI_API_KEY=your_openai_api_key_here
# MODEL_NAME=gpt-4o-mini

# --- Option 4: Ollama (local models) ---
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=glm-4.7-flash:latest

# SSL Configuration (for corporate proxies/TLS interception)
# VERIFY_SSL=false
# SSL_CERT_FILE=/path/to/corporate-ca-bundle.pem

# AWS BEDROCK AGENTCORE RUNTIME CONFIGURATION
# If using the AgentCore runtime mode, set the ARN of your deployed runtime here.
# WEALTH_ADVISORY_AGENT_RUNTIME_ARN=SAME ARN AS IN YOUR CONTRACT
# TFSA_AGENT_RUNTIME_ARN=SAME ARN AS IN YOUR CONTRACT